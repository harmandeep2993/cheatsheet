# Copy this file to .env and fill in real values. .env is git-ignored; this file is committed.
# Every variable the stack reads is listed here, with a safe placeholder.

# Password for the documents database (Postgres). Any long random string.
DOCUMENTS_DB_PASSWORD=change-me-to-a-long-random-string

# Optional. Without it chat-service answers with a built-in offline fake.
ANTHROPIC_API_KEY=

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
