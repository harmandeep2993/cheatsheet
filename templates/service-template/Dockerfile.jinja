# Build from the repository root so the shared libs/ folder is inside the build context:
#   docker build -f services/{{ service_name }}-service/Dockerfile .
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /bin/uv

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1
WORKDIR /app

# 1) Third-party dependencies only, cached until uv.lock or a pyproject.toml changes
COPY pyproject.toml uv.lock ./
COPY libs/common/pyproject.toml libs/common/pyproject.toml
COPY services/{{ service_name }}-service/pyproject.toml services/{{ service_name }}-service/pyproject.toml
RUN uv sync --frozen --no-dev --package {{ service_name }}-service --no-install-workspace

# 2) Our own code: the shared library and this service
COPY libs/common libs/common
COPY services/{{ service_name }}-service services/{{ service_name }}-service
RUN uv sync --frozen --no-dev --package {{ service_name }}-service --no-editable

ENV PATH="/app/.venv/bin:$PATH"
RUN useradd --create-home appuser
USER appuser

EXPOSE {{ port }}
CMD ["uvicorn", "--factory", "{{ package_name }}.main:create_app", "--host", "0.0.0.0", "--port", "{{ port }}"]
