"""API tests for {{ service_name }}-service. Run without Docker."""

import pytest
from fastapi.testclient import TestClient

from {{ package_name }}.config import Settings
from {{ package_name }}.main import create_app

TEST_MAX_ITEMS = 2


@pytest.fixture
def client():
    with TestClient(create_app(Settings(max_items=TEST_MAX_ITEMS))) as test_client:
        yield test_client


def test_health(client):
    assert client.get("/health").json() == {"status": "ok", "service": "{{ service_name }}-service"}


def test_create_and_list(client):
    assert client.post("/", json={"name": " first "}).json() == {"id": 1, "name": "first"}
    assert client.get("/").json() == [{"id": 1, "name": "first"}]


def test_limit_is_enforced(client):
    for number in range(TEST_MAX_ITEMS):
        assert client.post("/", json={"name": f"item {number}"}).status_code == 201
    assert client.post("/", json={"name": "one too many"}).status_code == 409


def test_empty_name_is_rejected(client):
    assert client.post("/", json={"name": ""}).status_code == 422
